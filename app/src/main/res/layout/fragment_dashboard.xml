<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     xmlns:tools="http://schemas.android.com/tools"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="?android:attr/colorBackground"
     android:fillViewport="true"
     android:clipToPadding="false">

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:paddingEnd="20dp"
         android:orientation="vertical"
         android:paddingBottom="110dp"
         android:paddingStart="20dp"
         android:paddingTop="20dp">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:gravity="center_vertical"
             android:orientation="horizontal">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="0dp"
                 android:textSize="20sp"
                 android:textColor="?attr/colorOnSurface"
                 android:layout_weight="1"
                 android:text="AnnounceUPI"
                 android:textStyle="bold" />

            <ImageButton
                 android:layout_height="40dp"
                 android:layout_width="40dp"
                 android:layout_marginEnd="6dp"
                 android:contentDescription="Notifications"
                 android:src="@drawable/bell"
                 android:background="?android:attr/selectableItemBackgroundBorderless"
                 android:padding="8dp"
                 app:tint="?attr/colorOnSurface"
                 android:id="@+id/btn_bell" />

            <ImageButton
                 android:layout_height="40dp"
                 android:layout_width="40dp"
                 android:contentDescription="Settings"
                 android:src="@drawable/ic_settings_gear"
                 android:background="?android:attr/selectableItemBackgroundBorderless"
                 android:padding="8dp"
                 app:tint="?attr/colorOnSurface"
                 android:id="@+id/btn_settings" />

        </LinearLayout>

        <LinearLayout
             android:layout_height="42dp"
             android:layout_width="match_parent"
             android:background="@drawable/bg_toggle_track"
             android:padding="3dp"
             android:orientation="horizontal"
             android:layout_marginTop="18dp"
             android:id="@+id/toggle_track">

            <TextView
                 android:layout_height="match_parent"
                 android:layout_width="0dp"
                 android:background="@drawable/bg_toggle_active"
                 android:gravity="center"
                 android:textSize="13sp"
                 android:textColor="?attr/colorOnSurface"
                 android:layout_weight="1"
                 android:id="@+id/toggle_daily"
                 android:text="D"
                 android:textStyle="bold" />

            <TextView
                 android:layout_height="match_parent"
                 android:layout_width="0dp"
                 android:gravity="center"
                 android:textSize="13sp"
                 android:textColor="?attr/colorOnSurfaceVariant"
                 android:layout_weight="1"
                 android:id="@+id/toggle_weekly"
                 android:text="W" />

            <TextView
                 android:layout_height="match_parent"
                 android:layout_width="0dp"
                 android:gravity="center"
                 android:textSize="13sp"
                 android:textColor="?attr/colorOnSurfaceVariant"
                 android:layout_weight="1"
                 android:id="@+id/toggle_monthly"
                 android:text="M" />

        </LinearLayout>

        <FrameLayout
             android:layout_height="220dp"
             android:layout_width="220dp"
             android:layout_marginTop="22dp"
             android:layout_gravity="center_horizontal">

            <com.upiannounce.app.RingProgressView
                 android:layout_height="match_parent"
                 android:layout_width="match_parent"
                 android:id="@+id/ring_progress" />

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:gravity="center_horizontal"
                 android:orientation="vertical"
                 android:layout_gravity="center">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:paddingEnd="12dp"
                     android:background="@drawable/bg_toggle_track"
                     android:paddingBottom="4dp"
                     android:textSize="11.5sp"
                     android:textColor="?attr/colorOnSurfaceVariant"
                     android:paddingStart="12dp"
                     tools:text="78%"
                     android:id="@+id/tv_ring_percent"
                     android:paddingTop="4dp" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:fontFamily="sans-serif-medium"
                     android:textSize="34sp"
                     android:textColor="?attr/colorOnSurface"
                     android:layout_marginTop="10dp"
                     tools:text="₹18,750"
                     android:id="@+id/tv_ring_amount" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="12sp"
                     android:textColor="?attr/colorOnSurfaceVariant"
                     android:layout_marginTop="4dp"
                     tools:text="of ₹24,000"
                     android:id="@+id/tv_ring_goal" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:paddingEnd="12dp"
                     android:background="@drawable/bg_toggle_track"
                     android:paddingBottom="5dp"
                     android:textSize="11.5sp"
                     android:textColor="?attr/colorOnSurfaceVariant"
                     android:paddingStart="12dp"
                     android:layout_marginTop="12dp"
                     tools:text="Today"
                     android:id="@+id/chip_period"
                     android:paddingTop="5dp" />

            </LinearLayout>

        </FrameLayout>

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:gravity="center"
             android:textSize="12.5sp"
             android:textColor="?attr/colorOnSurfaceVariant"
             android:layout_marginTop="14dp"
             tools:text="You've received 20% more than yesterday"
             android:id="@+id/tv_insight" />

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:background="@drawable/bg_card"
             android:padding="16dp"
             android:orientation="vertical"
             android:layout_marginTop="18dp">

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:gravity="center_vertical"
                 android:orientation="horizontal">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:textSize="12.5sp"
                     android:textColor="?attr/colorOnSurfaceVariant"
                     android:layout_weight="1"
                     android:text="This week trend" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="11.5sp"
                     android:textColor="?attr/colorOnSurfaceVariant"
                     tools:text="Total: ₹94,600"
                     android:id="@+id/tv_trend_total" />

            </LinearLayout>

            <com.upiannounce.app.SparklineView
                 android:layout_height="64dp"
                 android:layout_width="match_parent"
                 android:layout_marginTop="10dp"
                 android:id="@+id/sparkline_view" />

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:orientation="horizontal"
                 android:layout_marginTop="4dp"
                 android:id="@+id/trend_labels_row">

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:orientation="horizontal"
             android:layout_marginTop="14dp">

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="0dp"
                 android:layout_marginEnd="7dp"
                 android:background="@drawable/bg_card"
                 android:padding="14dp"
                 android:orientation="vertical"
                 android:layout_weight="1">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:layout_marginBottom="10dp"
                     android:textSize="12sp"
                     android:textColor="?attr/colorOnSurfaceVariant"
                     android:text="Top sources" />

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:orientation="vertical"
                     android:id="@+id/top_sources_container">

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="0dp"
                 android:background="@drawable/bg_card"
                 android:padding="14dp"
                 android:orientation="vertical"
                 android:layout_marginStart="7dp"
                 android:layout_weight="1">

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:layout_marginBottom="12dp"
                     android:gravity="center_vertical"
                     android:orientation="horizontal">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="0dp"
                         android:textSize="12sp"
                         android:textColor="?attr/colorOnSurfaceVariant"
                         android:layout_weight="1"
                         android:text="Peak hour" />

                    <ImageButton
                         android:layout_height="20dp"
                         android:layout_width="20dp"
                         android:contentDescription="What is peak hour"
                         android:src="@android:drawable/ic_dialog_info"
                         android:background="?android:attr/selectableItemBackgroundBorderless"
                         app:tint="?attr/colorOnSurfaceVariant"
                         android:id="@+id/btn_peak_info" />

                </LinearLayout>

                <LinearLayout
                     android:layout_height="46dp"
                     android:layout_width="match_parent"
                     android:gravity="bottom"
                     android:orientation="horizontal"
                     android:id="@+id/peak_bar_container">

                </LinearLayout>

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:orientation="horizontal"
                     android:layout_marginTop="6dp">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="0dp"
                         android:textSize="9sp"
                         android:textColor="?attr/colorOnSurfaceVariant"
                         android:layout_weight="1"
                         android:text="12 AM" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="0dp"
                         android:gravity="center"
                         android:textSize="9sp"
                         android:textColor="?attr/colorOnSurfaceVariant"
                         android:layout_weight="1"
                         android:text="12 PM" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="0dp"
                         android:gravity="end"
                         android:textSize="9sp"
                         android:textColor="?attr/colorOnSurfaceVariant"
                         android:layout_weight="1"
                         android:text="11 PM" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:background="@drawable/bg_card"
             android:padding="16dp"
             android:orientation="vertical"
             android:layout_marginTop="14dp">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:layout_marginBottom="12dp"
                 android:textSize="12sp"
                 android:textColor="?attr/colorOnSurfaceVariant"
                 android:text="Quick stats" />

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:orientation="horizontal">

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:gravity="center"
                     android:orientation="vertical"
                     android:layout_weight="1">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="14sp"
                         android:textColor="?attr/colorOnSurface"
                         tools:text="32"
                         android:id="@+id/tv_stat_payments"
                         android:textStyle="bold" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="9.5sp"
                         android:textColor="?attr/colorOnSurfaceVariant"
                         android:layout_marginTop="2dp"
                         android:text="Payments" />

                </LinearLayout>

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:gravity="center"
                     android:orientation="vertical"
                     android:layout_weight="1">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="14sp"
                         android:textColor="?attr/colorOnSurface"
                         tools:text="₹586"
                         android:id="@+id/tv_stat_average"
                         android:textStyle="bold" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="9.5sp"
                         android:textColor="?attr/colorOnSurfaceVariant"
                         android:layout_marginTop="2dp"
                         android:text="Average" />

                </LinearLayout>

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:gravity="center"
                     android:orientation="vertical"
                     android:layout_weight="1">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="14sp"
                         android:textColor="?attr/colorOnSurface"
                         tools:text="₹6,250"
                         android:id="@+id/tv_stat_best_hour"
                         android:textStyle="bold" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="9.5sp"
                         android:textColor="?attr/colorOnSurfaceVariant"
                         android:layout_marginTop="2dp"
                         android:text="Best hour" />

                </LinearLayout>

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:gravity="center"
                     android:orientation="vertical"
                     android:layout_weight="1">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="14sp"
                         android:textColor="?attr/colorOnSurface"
                         tools:text="2 PM"
                         android:id="@+id/tv_stat_peak_time"
                         android:textStyle="bold" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="9.5sp"
                         android:textColor="?attr/colorOnSurfaceVariant"
                         android:layout_marginTop="2dp"
                         android:text="Peak time" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>