<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 1. SNOW (Default Light) -->
    <style name="Theme.AnnounceUPI.Snow" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">#000000</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#F2F2F2</item>
        <item name="colorOnPrimaryContainer">#000000</item>
        <item name="android:colorBackground">#F7F7F5</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#111111</item>
        <item name="colorSurfaceVariant">#F2F2F2</item>
        <item name="colorOnSurfaceVariant">#6B6B6B</item>
        <item name="colorOutline">#E5E5E5</item>
        <item name="android:statusBarColor">#F7F7F5</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#F7F7F5</item>
    </style>

    <!-- 2. MIDNIGHT (Dark Blue) -->
    <style name="Theme.AnnounceUPI.Midnight" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#3B82F6</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#1E3A8A</item>
        <item name="colorOnPrimaryContainer">#BFDBFE</item>
        <item name="android:colorBackground">#0F172A</item>
        <item name="colorSurface">#1E293B</item>
        <item name="colorOnSurface">#E2E8F0</item>
        <item name="colorSurfaceVariant">#334155</item>
        <item name="colorOnSurfaceVariant">#94A3B8</item>
        <item name="colorOutline">#334155</item>
        <item name="android:statusBarColor">#0F172A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#0F172A</item>
    </style>

    <!-- 3. AMOLED (Pure Black) -->
    <style name="Theme.AnnounceUPI.Amoled" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#3DDC84</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorPrimaryContainer">#1B3A2B</item>
        <item name="colorOnPrimaryContainer">#B7F5D2</item>
        <item name="android:colorBackground">#000000</item>
        <item name="colorSurface">#0B0B0B</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorSurfaceVariant">#2C2C2C</item>
