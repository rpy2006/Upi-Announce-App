        <item name="android:statusBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>

    <!-- 4. SEPIA (Warm Light) -->
    <style name="Theme.AnnounceUPI.Sepia" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">#8B5E3C</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#E0D5C0</item>
        <item name="colorOnPrimaryContainer">#4B3621</item>
        <item name="android:colorBackground">#F5F0E6</item>
        <item name="colorSurface">#FFFBF0</item>
        <item name="colorOnSurface">#4B3621</item>
        <item name="colorSurfaceVariant">#E0D5C0</item>
        <item name="colorOnSurfaceVariant">#8B7355</item>
        <item name="colorOutline">#E0D5C0</item>
        <item name="android:statusBarColor">#F5F0E6</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#F5F0E6</item>
    </style>

    <!-- Base Theme -->
    <style name="Theme.AnnounceUPI" parent="Theme.AnnounceUPI.Snow" />
</resources>